# This package is built on Linux and consumed on every platform, and a checkout that rewrites line
# endings quietly breaks things nobody introduced: a snapshot compares unequal, a shipped .css or
# .js differs from the one that was tested. Git for Windows ships core.autocrlf=true in its system
# config, so without this file a Windows clone hands these files back as CRLF. Normalize in the
# repository AND in the working tree, on every platform.
* text=auto eol=lf

# Windows batch files are the one thing that genuinely needs CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.snk  binary
